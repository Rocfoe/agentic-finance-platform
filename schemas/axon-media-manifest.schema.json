{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universateach.local/schemas/axon-media-manifest.schema.json",
  "title": "AXON Media Manifest",
  "type": "object",
  "required": ["mediaId", "sourceType", "canonical", "renderers"],
  "properties": {
    "mediaId": { "type": "string", "minLength": 1 },
    "sourceType": { "enum": ["video", "image", "sequence", "svg", "procedural"] },
    "canonical": { "type": "boolean" },
    "sourceRef": { "type": "string" },
    "rightsStatus": { "type": "string" },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "semanticRole"],
        "properties": {
          "id": { "type": "string" },
          "semanticRole": { "type": "string" },
          "startSeconds": { "type": "number", "minimum": 0 },
          "endSeconds": { "type": "number", "minimum": 0 }
        }
      }
    },
    "renderers": {
      "type": "array",
      "items": {
        "enum": ["video-texture", "image", "webgl", "webgpu", "procedural", "graph", "timeline", "ui"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sourceIdentity": { "type": "string" },
        "capturedAt": { "type": "string" },
        "frame": { "type": "integer", "minimum": 0 },
        "transformation": { "type": "string" },
        "contentHash": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
